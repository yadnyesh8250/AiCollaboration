// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// User — platform-level account
// ─────────────────────────────────────────────────────────────
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  bio          String?    @db.Text
  avatarUrl    String?
  status       UserStatus @default(OFFLINE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // relations
  sessions             Session[]
  ownedOrganizations   Organization[]    @relation("OrgOwner")
  workspaceMemberships WorkspaceMember[]
}

// ─────────────────────────────────────────────────────────────
// Organization — top-level container (e.g. a company / team)
// ─────────────────────────────────────────────────────────────
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique          // url-friendly identifier
  description String?  @db.Text
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // owner
  ownerId  String
  owner    User   @relation("OrgOwner", fields: [ownerId], references: [id])

  // relations
  workspaces Workspace[]
}

// ─────────────────────────────────────────────────────────────
// Workspace — project space inside an Organization
// ─────────────────────────────────────────────────────────────
model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String                    // unique within org
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // belongs to
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // relations
  members WorkspaceMember[]

  @@unique([organizationId, slug])      // slug unique per org
}

// ─────────────────────────────────────────────────────────────
// WorkspaceMember — join table: User ↔ Workspace with a role
// ─────────────────────────────────────────────────────────────
model WorkspaceMember {
  id          String          @id @default(uuid())
  role        WorkspaceRole   @default(MEMBER)
  joinedAt    DateTime        @default(now())

  // FK to User
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FK to Workspace
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])       // one membership per user per workspace
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
}

// ─────────────────────────────────────────────────────────────
// Session — active login sessions
// ─────────────────────────────────────────────────────────────
model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique @db.VarChar(512)
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // FK to User
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}