// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// User — platform-level account
// ─────────────────────────────────────────────────────────────
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  firstName    String?
  lastName     String?
  bio          String?    @db.Text
  avatarUrl    String?
  status       UserStatus @default(OFFLINE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // relations
  sessions             Session[]
  ownedOrganizations   Organization[]    @relation("OrgOwner")
  workspaceMemberships WorkspaceMember[]
  organizationMembers  OrganizationMember[]
  invitesSent          WorkspaceInvite[] @relation("InvitedBy")
  notifications        Notification[]

  channelMembers       ChannelMember[]
  messages             Message[]
  reactions            Reaction[]
  mentionsReceived     Mention[]         @relation("MentionedUser")
  messageReads         MessageRead[]
  aiConversations      AIConversation[]
  aiAuditLogs          AIAuditLog[]
}

// ─────────────────────────────────────────────────────────────
// Organization — top-level container (e.g. a company / team)
// ─────────────────────────────────────────────────────────────
model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique          // url-friendly identifier
  description String?  @db.Text
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // owner
  ownerId  String
  owner    User   @relation("OrgOwner", fields: [ownerId], references: [id])

  // relations
  workspaces Workspace[]
  members    OrganizationMember[]
}

// ─────────────────────────────────────────────────────────────
// Workspace — project space inside an Organization
// ─────────────────────────────────────────────────────────────
model Workspace {
  id          String   @id @default(uuid())
  name        String
  slug        String                    // unique within org
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // belongs to
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // relations
  members WorkspaceMember[]
  invites WorkspaceInvite[]
  channels Channel[]
  aiConversations      AIConversation[]
  aiConfig             WorkspaceAIConfig?
  aiPersona            WorkspaceAIPersona?
  aiPermissions        AIPermission[]
  aiAuditLogs          AIAuditLog[]
  aiCache              AICache[]
  aiJobs               AIJob[]
  workspaceKnowledge   WorkspaceKnowledge[]
  workspaceMemory      WorkspaceMemory[]

  @@unique([organizationId, slug])      // slug unique per org
}

// ─────────────────────────────────────────────────────────────
// WorkspaceMember — join table: User ↔ Workspace with a role
// ─────────────────────────────────────────────────────────────
model WorkspaceMember {
  id          String          @id @default(uuid())
  role        WorkspaceRole   @default(MEMBER)
  joinedAt    DateTime        @default(now())

  // FK to User
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // FK to Workspace
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])       // one membership per user per workspace
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ONLINE
  OFFLINE
  AWAY
  DND
}

// ─────────────────────────────────────────────────────────────
// Session — active login sessions
// ─────────────────────────────────────────────────────────────
model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique @db.VarChar(512)
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  // FK to User
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// OrganizationMember — User ↔ Organization with a role
// ─────────────────────────────────────────────────────────────
model OrganizationMember {
  id             String           @id @default(uuid())
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  BILLING_ADMIN
  MEMBER
}

// ─────────────────────────────────────────────────────────────
// WorkspaceInvite — Pending invitations
// ─────────────────────────────────────────────────────────────
model WorkspaceInvite {
  id           String        @id @default(uuid())
  workspaceId  String
  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         WorkspaceRole
  token        String        @unique
  invitedById  String
  invitedBy    User          @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  status       InviteStatus  @default(PENDING)
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ─────────────────────────────────────────────────────────────
// AuditLog — Immutable history of actions
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id             String    @id @default(uuid())
  actorId        String?
  organizationId String?
  workspaceId    String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// Notification — In-app notifications
// ─────────────────────────────────────────────────────────────
model Notification {
  id          String   @id @default(uuid())
  recipientId String
  recipient   User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  type        String
  payload     Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Channel — Communication channels within a workspace
// ─────────────────────────────────────────────────────────────
model Channel {
  id          String   @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?  @db.Text
  type        ChannelType @default(PUBLIC)
  createdBy   String
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     ChannelMember[]
  messages    Message[]

  @@unique([workspaceId, slug])
}

enum ChannelType {
  PUBLIC
  PRIVATE
  ANNOUNCEMENT
  AI
}

// ─────────────────────────────────────────────────────────────
// ChannelMember — Membership for private channels
// ─────────────────────────────────────────────────────────────
model ChannelMember {
  id          String   @id @default(uuid())
  channelId   String
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        ChannelRole @default(MEMBER)
  joinedAt    DateTime @default(now())

  @@unique([channelId, userId])
}

enum ChannelRole {
  ADMIN
  MEMBER
}

// ─────────────────────────────────────────────────────────────
// Message — Core communication entity
// ─────────────────────────────────────────────────────────────
model Message {
  id              String   @id @default(uuid())
  channelId       String
  channel         Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content         String   @db.Text
  messageType     MessageType @default(TEXT)
  parentMessageId String?
  parentMessage   Message? @relation("ThreadReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  replies         Message[] @relation("ThreadReplies")
  attachments     Attachment[]
  reactions       Reaction[]
  mentions        Mention[]
  reads           MessageRead[]

  @@index([channelId])
  @@index([createdAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  SYSTEM
  AI
}

// ─────────────────────────────────────────────────────────────
// Attachment — Files attached to a message
// ─────────────────────────────────────────────────────────────
model Attachment {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String
  mimeType    String
  fileSize    Int
  uploadedBy  String
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Reaction — Emoji reactions on messages
// ─────────────────────────────────────────────────────────────
model Reaction {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji       String
  createdAt   DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

// ─────────────────────────────────────────────────────────────
// Mention — Mentions of users in messages
// ─────────────────────────────────────────────────────────────
model Mention {
  id              String   @id @default(uuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation("MentionedUser", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// MessageRead — Read receipts
// ─────────────────────────────────────────────────────────────
model MessageRead {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt      DateTime @default(now())

  @@unique([messageId, userId])
}

// ─────────────────────────────────────────────────────────────
// AIConversation — ChatGPT-like multi-turn threads
// ─────────────────────────────────────────────────────────────
model AIConversation {
  id          String       @id @default(uuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   String
  user        User         @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  title       String       @default("New Chat")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  messages    AIMessage[]
}

// ─────────────────────────────────────────────────────────────
// AIMessage — Message nodes supporting conversation branching
// ─────────────────────────────────────────────────────────────
model AIMessage {
  id             String         @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AIRole
  content        String         @db.Text
  parentId       String?
  parent         AIMessage?     @relation("Branching", fields: [parentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  branches       AIMessage[]    @relation("Branching")
}

enum AIRole {
  SYSTEM
  USER
  ASSISTANT
}

// ─────────────────────────────────────────────────────────────
// WorkspaceMemory — Key-Value configurations for system prompt instructions
// ─────────────────────────────────────────────────────────────
model WorkspaceMemory {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key         String
  value       String    @db.Text
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, key])
}

// ─────────────────────────────────────────────────────────────
// WorkspaceKnowledge — Unstructured pages indexed for RAG
// ─────────────────────────────────────────────────────────────
model WorkspaceKnowledge {
  id          String            @id @default(uuid())
  workspaceId String
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category    KnowledgeCategory @default(FAQ)
  title       String
  content     String            @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

enum KnowledgeCategory {
  FAQ
  STANDARD
  SPRINT_GOALS
  DEPLOYMENT
}

// ─────────────────────────────────────────────────────────────
// AIPermission — Restricts AI tools inside a workspace
// ─────────────────────────────────────────────────────────────
model AIPermission {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  toolName    String
  isAllowed   Boolean   @default(true)

  @@unique([workspaceId, toolName])
}

// ─────────────────────────────────────────────────────────────
// AIAuditLog — Tracks credits, tokens, latency, cost
// ─────────────────────────────────────────────────────────────
model AIAuditLog {
  id                String    @id @default(uuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId           String
  user              User      @relation(fields: [actorId], references: [id], onDelete: Cascade)
  prompt            String    @db.Text
  agentType         String
  toolUsed          String?
  toolResult        String?   @db.Text
  modelUsed         String
  promptTokens      Int
  completionTokens  Int
  latencyMs         Int
  estimatedCostUsd  Decimal   @db.Decimal(10, 6)
  createdAt         DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────
// WorkspaceAIConfig — Configuration variables per workspace
// ─────────────────────────────────────────────────────────────
model WorkspaceAIConfig {
  id                String    @id @default(uuid())
  workspaceId       String    @unique
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  preferredModel    String    @default("gemini-2.5-flash")
  temperature       Float     @default(0.7)
  maxTokens         Int       @default(2048)
  baseSystemPrompt  String?   @db.Text
}

// ─────────────────────────────────────────────────────────────
// WorkspaceAIPersona — Personalities / AI profiles per workspace
// ─────────────────────────────────────────────────────────────
model WorkspaceAIPersona {
  id          String      @id @default(uuid())
  workspaceId String      @unique
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String      @default("CollabBot")
  behavior    AIBehavior  @default(HELPFUL)
}

enum AIBehavior {
  HELPFUL
  STRICT
  TECHNICAL
  CREATIVE
}

// ─────────────────────────────────────────────────────────────
// AICache — Intercepts requests to cut costs
// ─────────────────────────────────────────────────────────────
model AICache {
  id           String    @id @default(uuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  queryHash    String
  responseText String    @db.Text
  expiresAt    DateTime

  @@unique([workspaceId, queryHash])
}

// ─────────────────────────────────────────────────────────────
// AIJob — Backend cron/async job queue logger
// ─────────────────────────────────────────────────────────────
model AIJob {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobType     String
  status      JobStatus @default(PENDING)
  payload     Json?
  result      String?   @db.Text
  runAt       DateTime
  createdAt   DateTime  @default(now())
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}